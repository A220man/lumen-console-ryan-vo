# Database
DATABASE_URL=postgresql+asyncpg://lumen:lumen@db:5432/lumen

# Encryption (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# GitHub (optional - for private repos and higher rate limits)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=

# Keycloak OIDC
OIDC_ISSUER=http://keycloak:8080/realms/lumen
OIDC_CLIENT_ID=lumen-console
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5173/callback

# Frontend
VITE_API_BASE=http://127.0.0.1:8000
VITE_OIDC_ISSUER=http://127.0.0.1:8080/realms/lumen
VITE_OIDC_CLIENT_ID=lumen-console
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/callback

# Demo mode (binds to localhost only, REFUSED in production)
DEMO_MODE=true